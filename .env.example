# DagsHub / MLflow Configuration
# Replace these with your own DagsHub credentials:
# 1. Create a repository on https://dagshub.com
# 2. Go to Remote -> MLflow to get your tracking URI and access token
MLFLOW_TRACKING_URI=https://dagshub.com/<YOUR_DAGSHUB_USERNAME>/<YOUR_REPO_NAME>.mlflow
MLFLOW_TRACKING_USERNAME=<YOUR_DAGSHUB_USERNAME>
MLFLOW_TRACKING_PASSWORD=<YOUR_DAGSHUB_TOKEN>

# Web Application Port (Optional - defaults to 8080)
PORT=8080
